# 工作区记忆与编辑器配置（个人工作记录，不入库）
.workbuddy/
.vscode/
.idea/

# 依赖与构建产物
node_modules/
dist/
dist-ssr/

# 部署包（由 npm run pack 生成）
deploy/

# 本地调试产物：诊断脚本、截图、临时文件
.research/
.tmp/
*.log

# 环境变量与本地密钥（API Key 只放本地，绝不入库）
.env
.env.*
!.env.example

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 旧版本备份
*.bak
*.old

# 应用发布标记文件（工具生成，不入库）
.wbapp_*.genie

# 演示视频体积大，不进仓库（提交时单独上传）
*.mp4
*.mov

# 比赛提交材料汇总（含视频副本，体积大，单独上传）
提交材料/

# 排版检查用的临时截图
docs/_*.png
