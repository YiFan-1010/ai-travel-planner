{
  "name": "ai-travel-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 驱动的多日旅行路线规划器 · MapLibre + DeepSeek · 真实道路路线与 3D 地球",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "pack": "npm run build && node scripts/pack-deploy.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18"
  }
}
