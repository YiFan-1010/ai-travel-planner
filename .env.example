# 服务端密钥（只在服务端读取，绝不进前端打包产物）
# 复制本文件为 .env 后填写真实值

# DeepSeek（或任意 OpenAI 兼容端点）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德 Web 服务 Key（不是 Web端 JS API）
AMAP_KEY=

# 限流：单 IP 每小时对话次数 / 单 IP 每小时地理编码次数
RL_CHAT_PER_HOUR=12
RL_GEO_PER_HOUR=120
# 全局每日上限，兜住额度
RL_CHAT_PER_DAY=220
RL_GEO_PER_DAY=4000

# 服务端口
PORT=8080
